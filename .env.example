# NYC Rent Seekers — environment template (no secrets committed)
# Copy to .env for local overrides. Never put tokens in source or dist/.

# Optional basemap style URL (leave empty for data-only style)
# RENT_SEEKERS_BASEMAP_STYLE=

# Static serve origin for status.json dashboard_url (local default)
RENT_SEEKERS_DASHBOARD_URL=http://127.0.0.1:8791/
