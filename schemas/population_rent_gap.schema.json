{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyc-rent-seekers.local/schemas/population_rent_gap.schema.json",
  "title": "population_rent_gap",
  "type": "object",
  "required": [
    "derived_type",
    "gap_id",
    "gap_type",
    "operation",
    "minuend_observation_id",
    "subtrahend_observation_id",
    "minuend_housing_regime",
    "minuend_tenure_cohort",
    "subtrahend_housing_regime",
    "subtrahend_tenure_cohort",
    "geography_id",
    "geography_type",
    "geography_name",
    "survey_vintage",
    "measure",
    "measure_basis",
    "gross_or_net",
    "statistic",
    "currency",
    "cadence",
    "dollar_difference",
    "percent_difference",
    "percent_denominator_observation_id",
    "direction",
    "comparability_notes",
    "uncertainty_note",
    "inference_class",
    "illustrative",
    "causal_claim_allowed"
  ],
  "properties": {
    "derived_type": { "const": "population_rent_gap" },
    "gap_id": { "type": "string", "minLength": 1 },
    "gap_type": {
      "type": "string",
      "enum": [
        "incumbency_within_regime",
        "same_tenure_regulation",
        "illustrative_cross_regime"
      ]
    },
    "operation": { "const": "minuend_minus_subtrahend" },
    "minuend_observation_id": { "type": "string", "minLength": 1 },
    "subtrahend_observation_id": { "type": "string", "minLength": 1 },
    "minuend_housing_regime": { "type": "string", "minLength": 1 },
    "minuend_tenure_cohort": { "type": "string", "minLength": 1 },
    "subtrahend_housing_regime": { "type": "string", "minLength": 1 },
    "subtrahend_tenure_cohort": { "type": "string", "minLength": 1 },
    "geography_id": { "type": "string", "minLength": 1 },
    "geography_type": { "type": "string", "minLength": 1 },
    "geography_name": { "type": "string", "minLength": 1 },
    "survey_vintage": { "type": "string", "minLength": 1 },
    "measure": { "type": "string", "minLength": 1 },
    "measure_basis": {
      "type": "string",
      "enum": ["actual_paid", "asking", "regulatory_market_benchmark", "index"]
    },
    "gross_or_net": { "type": "string", "minLength": 1 },
    "statistic": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "minLength": 1 },
    "cadence": { "type": "string", "minLength": 1 },
    "dollar_difference": { "type": "number" },
    "percent_difference": { "type": ["number", "null"] },
    "percent_denominator_observation_id": { "type": "string", "minLength": 1 },
    "direction": { "type": "string", "enum": ["positive", "negative", "zero"] },
    "comparability_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "uncertainty_note": { "type": "string", "minLength": 1 },
    "inference_class": { "const": "descriptive_only" },
    "illustrative": { "type": "boolean" },
    "causal_claim_allowed": { "const": false }
  },
  "additionalProperties": false
}
