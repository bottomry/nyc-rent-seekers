{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyc-rent-seekers.local/schemas/demo_bundle.schema.json",
  "title": "NYC Rent Seekers demo evidence bundle",
  "type": "object",
  "required": [
    "meta",
    "developments",
    "tenant_rent_observations",
    "market_areas",
    "market_rent_observations",
    "comparisons",
    "source_artifacts",
    "geometries"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["project", "stage", "release_id", "built_at", "calculation_version"],
      "properties": {
        "project": { "const": "nyc-rent-seekers" },
        "stage": { "type": "string" },
        "release_id": { "type": "string", "minLength": 1 },
        "built_at": { "type": "string" },
        "calculation_version": { "type": "string" },
        "coverage_note": { "type": "string" },
        "product_language": { "type": "object" }
      }
    },
    "developments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["development_id", "name"],
        "properties": {
          "development_id": { "type": "string" },
          "name": { "type": "string" },
          "tds_id": { "type": ["string", "null"] },
          "hud_amp_id": { "type": ["string", "null"] },
          "current_unit_count": { "type": ["integer", "null"] }
        }
      }
    },
    "tenant_rent_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "housing_development_id",
          "period_start",
          "value",
          "measure_basis",
          "unit_scope",
          "source_artifact_id"
        ],
        "properties": {
          "observation_id": { "type": "string" },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "unit_scope": { "type": "string" },
          "source_url": { "type": ["string", "null"] }
        }
      }
    },
    "market_rent_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "market_area_id",
          "period_start",
          "value",
          "measure_basis",
          "unit_scope",
          "source_artifact_id"
        ],
        "properties": {
          "observation_id": { "type": "string" },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "bedroom_count": { "type": ["integer", "null"] },
          "source_url": { "type": ["string", "null"] }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "comparison_id",
          "housing_development_id",
          "tenant_rent_observation_id",
          "market_rent_observation_id",
          "monthly_wedge_usd",
          "annualized_wedge_usd",
          "percent_below_comparator",
          "comparison_quality",
          "quality_reasons",
          "calculation_version"
        ],
        "properties": {
          "monthly_wedge_usd": { "type": "number" },
          "annualized_wedge_usd": { "type": "number" },
          "percent_below_comparator": { "type": "number", "minimum": 0, "maximum": 1 },
          "comparison_quality": {
            "type": "string",
            "enum": ["exact", "strong", "representative", "context_only", "unavailable"]
          },
          "quality_reasons": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "source_id", "source_url", "retrieved_at"],
        "properties": {
          "source_url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "market_areas": { "type": "array" },
    "geometries": {
      "type": "object",
      "required": ["boroughs", "developments", "market_areas"],
      "properties": {
        "boroughs": { "type": "object" },
        "developments": { "type": "object" },
        "development_points": { "type": "object" },
        "market_areas": { "type": "object" },
        "ntas": { "type": "object" },
        "tracts": { "type": "object" }
      }
    },
    "geometry_review": {
      "type": "object",
      "properties": {
        "rows": { "type": "array" },
        "counts": { "type": "object" }
      }
    },
    "map": { "type": "object" }
  },
  "additionalProperties": true
}
